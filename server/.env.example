# Copy this file to server/.env and fill in real values. Never commit .env.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/skywards
OTP_SECRET=any-long-random-string
DEMO_MODE=true
PORT=4000

# Secret used to sign login tokens (required for register/login). Use a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=any-other-long-random-string
